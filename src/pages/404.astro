---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 白盒" description="页面不存在">
  <main style="max-width: 42rem; margin: 0 auto; padding: 4rem 1.25rem; text-align: center">
    <div style="font-size: 2.5rem; font-weight: 600; letter-spacing: .04em; margin-bottom: .5rem">404</div>
    <p style="color: #5a5a52; margin-bottom: 1.75rem">这个地址下还没有内容。</p>
    <p style="color: #5a5a52; margin-bottom: 1.75rem">
      也许它还在写，也许从来没写过。
    </p>
    <a
      href="/"
      style="display: inline-block; padding: .5rem 1.1rem; border: 1px solid #d8d3c8; border-radius: 6px; text-decoration: none; color: #2b5c4e"
    >
      回到首页
    </a>
  </main>
</BaseLayout>
