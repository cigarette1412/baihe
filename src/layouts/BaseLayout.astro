---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { domainList } from '../data/domains.js';

const { title, description, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/favicon.svg', Astro.site).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2b5c4e" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="白盒" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap-wide inner">
        <a class="brand" href="/">白盒<span class="dot">.</span>org</a>
        <span class="tagline">把每个原理拆到不能再拆</span>
        <nav style="margin-left:auto; display:flex; gap:.9rem; font-size:.84rem;">
          {domainList.map((d) => <a href={`/domains/${d.slug}`} style="color:#4a4a46">{d.name}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap-wide">
        <div>白盒 · baihe.org —— 本站内容采用 CC BY-SA 4.0 许可，代码采用 MIT 许可。</div>
        <div style="margin-top:.35rem">
          看到一个错字、一段没讲清楚的话？<a href="https://github.com/">在 GitHub 上提一个 PR</a>。
        </div>
      </div>
    </footer>
  </body>
</html>
